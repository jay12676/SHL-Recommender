# Copy to .env and fill in. The service reads these at startup.

# Required for the LLM agent (free tier: https://console.groq.com/keys)
GROQ_API_KEY=

# Optional overrides (sensible defaults are baked in)
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=12
LLM_MAX_RETRIES=2

# Retrieval
USE_EMBEDDINGS=false
N_CANDIDATES=30

# Agent
MAX_CLARIFYING_TURNS=2
